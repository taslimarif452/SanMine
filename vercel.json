{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/gmail/index.ts": {
      "maxDuration": 30
    },
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/gmail/(.*)",
      "destination": "/api/gmail/index"
    },
    {
      "source": "/api/gmail",
      "destination": "/api/gmail/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
