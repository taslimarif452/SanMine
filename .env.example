# ==============================================================================
# SANMine Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER-SIDE ONLY VARIABLES (Do NOT prefix with VITE_)
# Add these to Vercel Project Settings -> Environment Variables
# ------------------------------------------------------------------------------

# Gemini AI API Key (Server fallback if user has not set their own key in Settings)
GEMINI_API_KEY=

# OpenAI API Key (Server fallback if user has not set their own key in Settings)
OPENAI_API_KEY=

# OpenRouter AI API Key (Server fallback if user has not set their own key in Settings)
OPENROUTER_API_KEY=

# Neon PostgreSQL Database Connection String (Server-side persistence)
DATABASE_URL=
NEON_DATABASE_URL=

# Server-side AES-256-GCM Credential Encryption Key for per-user API keys & tokens (32+ chars)
CREDENTIAL_ENCRYPTION_KEY=

# Google OAuth for Gmail Integration (gmail.send scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_OAUTH_STATE_SECRET=

# Deployment URL / Application Root URL (e.g. https://your-project.vercel.app)
APP_URL=

# Optional local server port (defaults to 3000)
PORT=3000

# ------------------------------------------------------------------------------
# CLIENT-SIDE ENVIRONMENT VARIABLES (Exposed to browser via Vite)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
